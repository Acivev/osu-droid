<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Runs in its own process so Verktex does not share engine/BASS state with AndEngine. -->
        <activity
            android:name="com.osudroid.verktex.VerktexTestActivity"
            android:exported="true"
            android:process=":verktex"
            android:label="Verktex Test"
            android:taskAffinity="com.osudroid.verktex"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.AppCompat.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
